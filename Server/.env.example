# Copy this file to .env and replace the placeholders.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillbridge?retryWrites=true&w=majority
PORT=5000
# Generate a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
# Optional when frontend is served by this backend; comma-separated origins if hosted separately.
CLIENT_ORIGIN=http://localhost:3000
